
# Dedicated CampLink mailbox
CAMPLINK_IMAP_HOST=imap.example.com
CAMPLINK_IMAP_PORT=993
CAMPLINK_IMAP_USER=bridge@example.com
CAMPLINK_IMAP_PASSWORD=replace-me

# SMTP for the trusted test utility
CAMPLINK_SMTP_HOST=smtp.example.com
CAMPLINK_SMTP_PORT=465
CAMPLINK_SMTP_USER=bridge@example.com
CAMPLINK_SMTP_PASSWORD=replace-me
CAMPLINK_MAIL_ADDRESS=bridge@example.com

# Independent keys
CAMPLINK_MAIL_PACKET_SIGNING_KEY=replace-me
CAMPLINK_EMAIL_GATEWAY_SECRET=replace-me

# Main CampLink API
CAMPLINK_BACKEND_URL=http://127.0.0.1:5100
CAMPLINK_POLL_SECONDS=30
